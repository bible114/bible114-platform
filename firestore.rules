rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isRealUser() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isPlatformAdmin() {
      return isSignedIn() &&
        myData().role in ['platformAdmin', 'superAdmin'] &&
        myData().get('isDeleted', false) != true;
    }
    function isChurchAdmin(churchId) {
      return isSignedIn() &&
        myData().role == 'churchAdmin' &&
        myData().churchId == churchId &&
        myData().get('isDeleted', false) != true;
    }
    function sameChurch(churchId) {
      return isSignedIn() && myData().churchId == churchId;
    }
    // [라운드 10] 조직 명부 멤버 — 개인 계정(churchId null)·타 교회 소속이라도
    // 그 조직 roster에 올라 있으면 공동체 콘텐츠(공지·상점 설정·구매)를 쓸 수 있다.
    function isRosterMember(churchId) {
      return isRealUser() &&
        exists(/databases/$(database)/documents/churches/$(churchId)/roster/$(request.auth.uid));
    }
    // personal 사용자의 primary roster는 곧 지갑 원장이다. 본인·공동체 관리자·
    // 플랫폼 관리자 브라우저도 삭제할 수 없고, 기준 변경/제명은 서버 action만 맡는다.
    function isPersonalPrimaryRoster(churchId, memberUid) {
      let before = get(/databases/$(database)/documents/users/$(memberUid)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(memberUid)).data;
      return exists(/databases/$(database)/documents/users/$(memberUid)) &&
        ((before.get('accountType', null) == 'personal' &&
            before.get('primaryOrgId', null) == churchId) ||
          (after.get('accountType', null) == 'personal' &&
            after.get('primaryOrgId', null) == churchId));
    }
    function isAllowedPlanId(planId) {
      return planId in [
        '1year_sequential', '1year_revised', '1year_new', 'nt_new',
        'readable_revised', 'readable_new'
      ];
    }
    function planTotalDays(planId) {
      return planId in ['readable_revised', 'readable_new'] ? 60 : 365;
    }
    function hasProtectedCredentialCopy(uid, before) {
      let path = /databases/$(database)/documents/users/$(uid)/private/auth;
      return existsAfter(path) &&
        (!before.keys().hasAny(['password']) ||
          before.get('password', null) == null ||
          getAfter(path).data.password == before.password) &&
        (!before.keys().hasAny(['phone4']) ||
          getAfter(path).data.phone4 == before.phone4);
    }
    // 플랫폼 관리자의 교차 사용자 users 쓰기는 아래 네 payload 외에는 열지 않는다.
    function isPlatformAdminMemberOrganizationUpdate(before, after) {
      let changed = after.diff(before).affectedKeys();
      return before.get('role', null) == 'member' &&
        after.get('role', null) == before.get('role', null) &&
        before.get('accountType', null) != 'personal' &&
        after.get('accountType', null) == before.get('accountType', null) &&
        before.get('isDeleted', false) == false &&
        after.get('isDeleted', false) == false &&
        changed.hasAny([
          'churchId', 'churchName', 'departmentId', 'departmentName',
          'subgroupId', 'subgroupName'
        ]) &&
        changed.hasOnly([
          'churchId', 'churchName', 'departmentId', 'departmentName',
          'subgroupId', 'subgroupName', 'updatedAt'
        ]) &&
        changed.hasAny(['updatedAt']) &&
        after.updatedAt == request.time;
    }
    function isPlatformAdminCredentialParentCleanup(uid, before, after) {
      let changed = after.diff(before).affectedKeys();
      return changed.hasAny(['password', 'phone4']) &&
        changed.hasOnly(['password', 'phone4']) &&
        after.keys().hasAll(['password']) &&
        after.password == null &&
        !after.keys().hasAny(['phone4']) &&
        hasProtectedCredentialCopy(uid, before);
    }
    function isPlatformAdminTalentReset(before, after) {
      let changed = after.diff(before).affectedKeys();
      return changed.hasAny(['talent', 'talentMigrated', 'talentWalletMigrated']) &&
        changed.hasOnly([
          'talent', 'talentMigrated', 'talentWalletMigrated', 'updatedAt'
        ]) &&
        changed.hasAny(['updatedAt']) &&
        after.talent == 0 &&
        after.talentMigrated == true &&
        after.talentWalletMigrated == true &&
        after.updatedAt == request.time;
    }
    function isPlatformAdminTimestampTouch(before, after) {
      let changed = after.diff(before).affectedKeys();
      return changed.hasAny(['updatedAt']) &&
        changed.hasOnly(['updatedAt']) &&
        after.updatedAt == request.time;
    }
    // 사용자가 브라우저에서 직접 바꿀 수 있는 값은 화면 환경설정과
    // 검증 가능한 계정 메타데이터로 한정한다. 읽기·퀴즈·보상 predicate는
    // platform-api의 원자적 action만 갱신한다.
    function isSafeSelfPreferenceUpdate(before, after) {
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly([
          'primaryOrgId', 'dayOffset',
          'authProvider', 'authProviders', 'password', 'phone4',
          'quizLevel', 'dailyVideoCollapsed', 'videoMode', 'updatedAt'
        ]) &&
        (!changed.hasAny(['updatedAt']) || after.updatedAt == request.time) &&
        (!changed.hasAny(['primaryOrgId']) ||
          (after.get('accountType', null) == 'personal' &&
            (after.get('primaryOrgId', null) == null ||
              existsAfter(/databases/$(database)/documents/churches/$(after.primaryOrgId)/roster/$(request.auth.uid))))) &&
        (!changed.hasAny(['dayOffset']) ||
          (after.dayOffset is int && after.dayOffset >= -364 && after.dayOffset <= 364)) &&
        (!changed.hasAny(['authProvider']) ||
          after.authProvider in ['password', 'google.com', 'kakao.com']) &&
        (!changed.hasAny(['authProviders']) ||
          (after.authProviders is list &&
            after.authProviders.size() >= 1 &&
            after.authProviders.size() <= 3 &&
            after.authProviders.hasOnly(['password', 'google.com', 'kakao.com']) &&
            after.authProviders.hasAll([after.authProvider]) &&
            after.authProviders.toSet().size() == after.authProviders.size())) &&
        (!changed.hasAny(['password', 'phone4']) ||
          (after.get('password', null) == null &&
            !after.keys().hasAny(['phone4']) &&
            hasProtectedCredentialCopy(request.auth.uid, before))) &&
        (!changed.hasAny(['quizLevel']) ||
          after.quizLevel in ['standard', 'easy']) &&
        (!changed.hasAny(['dailyVideoCollapsed']) ||
          after.dailyVideoCollapsed is bool) &&
        (!changed.hasAny(['videoMode']) ||
          after.videoMode in ['adult', 'kids']);
    }
    function isSafeSelfPlanChange(before, after) {
      let changed = after.diff(before).affectedKeys();
      let totalDays = planTotalDays(after.planId);
      let beforeDay = before.get('currentDay', 1);
      return changed.hasAny(['planId', 'currentDay']) &&
        changed.hasOnly(['planId', 'currentDay', 'updatedAt']) &&
        isAllowedPlanId(after.planId) &&
        beforeDay is int && beforeDay >= 1 && beforeDay <= 365 &&
        after.currentDay is int &&
        after.currentDay == ((beforeDay - 1) % totalDays) + 1 &&
        after.updatedAt == request.time;
    }
    // dailyVideos의 adult/kids 항목 검증: 없거나(null), url 필드가 없거나, url이 빈 문자열이면
    // 통과(자동 채움 실패 시 그런 형태로 기록됨). url이 있으면 반드시 유튜브 도메인이어야 한다.
    // RE2 정규식이라 리터럴 마침표는 [.]로 이스케이프한다.
    function validVideoEntry(e) {
      return e == null || !('url' in e) || e.url == '' ||
        e.url.matches('^https://(www[.])?(youtube[.]com|youtu[.]be)/.*');
    }
    function isPublicDirectoryReady() {
      let meta = get(/databases/$(database)/documents/publicDirectoryMeta/current).data;
      return meta.keys().hasOnly(
          ['ready', 'mode', 'schemaVersion', 'count', 'updatedAt']) &&
        meta.keys().hasAll(['ready', 'mode', 'schemaVersion', 'count']) &&
        meta.ready == true &&
        meta.mode == 'public' &&
        meta.schemaVersion == 1 &&
        meta.count is int &&
        meta.count >= 0;
    }

    // 사용자 문서
    match /users/{uid} {
      // [랭킹] 마지막 분기: 같은 교회 교인의 목록 조회 허용(랭킹·달리기·주간MVP).
      // 단 자격증명(password/phone4)이 private 하위문서로 이관 완료된 문서
      // (password == null 마커)만 — 이관 전 평문 노출 창을 규칙 수준에서 차단한다.
      // 클라이언트 목록 쿼리는 반드시 .where('password', '==', null)을 포함해야
      // 규칙 증명을 통과한다 (useDepartment.loadAllMembers 참고).
      // 무소속 가상 교회(unaffiliated_v1)는 전국 단위 익명 집단이라 서로 열지 않는다.
      allow read: if request.auth.uid == uid ||
        (isSignedIn() && isChurchAdmin(resource.data.churchId)) ||
        isPlatformAdmin() ||
        (sameChurch(resource.data.churchId) &&
          resource.data.churchId != 'unaffiliated_v1' &&
          resource.data.password == null) ||
        // [라운드 9] 명부(roster) 멤버의 조직 자체 교인 읽기 — 개인 계정(churchId null)이나
        // 타 교회 소속이라도, 그 조직 명부에 올라 있으면 그 조직 교인 목록(랭킹)을 볼 수 있다.
        // 목록 쿼리: .where('churchId','==',org).where('password','==',null) — churchId가 필터로
        // 증명되므로 exists 경로가 구체화되어 규칙 증명을 통과한다.
        (isRealUser() &&
          resource.data.churchId != 'unaffiliated_v1' &&
          resource.data.password == null &&
          exists(/databases/$(database)/documents/churches/$(resource.data.churchId)/roster/$(request.auth.uid)));
      // 모든 최초 users 문서는 검증된 서버 가입 action만 생성한다.
      allow create: if false;
      // 본인은 화면 환경설정·검증 가능한 메타데이터와 정규화된 플랜 전환만 쓴다.
      // 읽기·퀴즈·보상·지갑·업적 상태는 이 분기에서 절대 바뀌지 않는다.
      allow update: if (isRealUser() && request.auth.uid == uid &&
          resource.data.get('isDeleted', false) != true &&
          request.resource.data.get('isDeleted', false) != true &&
          (isSafeSelfPreferenceUpdate(resource.data, request.resource.data) ||
            isSafeSelfPlanChange(resource.data, request.resource.data))) ||
        // 공동체 관리자의 일반 교인 활성 상태는 통계 원장과 함께 바뀌어야 하므로
        // platform-api 전용 action만 쓴다. 브라우저는 소속 배정만 할 수 있다.
        (isSignedIn() &&
          resource.data.role == 'member' &&
          request.resource.data.role == 'member' &&
          isChurchAdmin(resource.data.churchId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'departmentId', 'departmentName', 'subgroupId', 'subgroupName',
            'extraMemberships', 'updatedAt'
          ]) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['extraMemberships']) ||
            (request.resource.data.extraMemberships is list &&
              request.resource.data.extraMemberships.size() <= 3))) ||
        (isPlatformAdmin() && (
          isPlatformAdminMemberOrganizationUpdate(
            resource.data,
            request.resource.data
          ) ||
          isPlatformAdminCredentialParentCleanup(
            uid,
            resource.data,
            request.resource.data
          ) ||
          isPlatformAdminTalentReset(
            resource.data,
            request.resource.data
          ) ||
          isPlatformAdminTimestampTouch(
            resource.data,
            request.resource.data
          )
        ));
      // 구형 users.memos 대형 필드는 월별 하위문서 이관을 재검증한 클라이언트가
      // 삭제만 할 수 있다. 점수·달란트 호환 상태와 무관하게 오래된 사용자도
      // 용량 위험에서 빠져나오되, 이 분기로 묵상 내용이나 다른 필드를 바꾸지는 못한다.
      allow update: if isRealUser() &&
        request.auth.uid == uid &&
        resource.data.get('isDeleted', false) != true &&
        request.resource.data.get('isDeleted', false) != true &&
        resource.data.keys().hasAny(['memos']) &&
        !request.resource.data.keys().hasAny(['memos']) &&
        request.resource.data.get('memoStorageVersion', 0) == 2 &&
        request.resource.data.memoMigratedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['memos', 'memoStorageVersion', 'memoMigratedAt', 'updatedAt']);
      // 개인 지갑 이관과 창구 판매·환불은 platform-api가 transaction으로 처리한다.
      // 브라우저에는 users.talent 감소·talentWalletMigrated 변경 권한을 열지 않는다.
      // [라운드 10] 개인 계정 전환(일방향, 본인만): 교회 교인 → accountType 'personal' + churchId null.
      // 전환 전에 자기 roster 행(구 교회)이 먼저 만들어져 있어야 한다 — 소속이 명부 원장으로
      // 보존됨을 규칙 수준에서 강제. 다른 교회로의 churchId 변경이나 personal → 교회 복귀는
      // 이 분기로 열리지 않는다 (역방향은 라운드 후보).
      allow update: if request.auth.uid == uid &&
        resource.data.role == 'member' &&
        request.resource.data.role == 'member' &&
        resource.data.get('isDeleted', false) != true &&
        request.resource.data.get('isDeleted', false) != true &&
        resource.data.get('accountType', null) != 'personal' &&
        resource.data.churchId is string &&
        resource.data.churchId != 'unaffiliated_v1' &&
        request.resource.data.churchId == null &&
        request.resource.data.accountType == 'personal' &&
        request.resource.data.get('primaryOrgId', null) == resource.data.churchId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['accountType', 'email', 'churchId', 'churchName', 'primaryOrgId', 'updatedAt']) &&
        exists(/databases/$(database)/documents/churches/$(resource.data.churchId)/roster/$(request.auth.uid));
      // 사용자 본문서는 테스트 계정도 hard-delete하지 않는다.
      // 정리 작업 역시 통계 원장과 결속된 서버 action만 사용한다.
      allow delete: if false;

      // 가입 동의 원문 — 보호자 성명·관계 등 감사용 개인정보가 포함될 수 있으므로
      // 공동체 관리자에게는 읽기·쓰기를 열지 않는다. 본인은 재가입 시 최신 동의로
      // 갱신할 수 있고, 플랫폼 관리자는 분쟁 대응을 위한 읽기만 가능하다.
      match /private/consent {
        allow read: if isRealUser() && (request.auth.uid == uid || isPlatformAdmin());
        allow create, update: if isRealUser() && request.auth.uid == uid;
        allow delete: if false;
      }

      // 자격증명 하위문서 (평문 비밀번호·phone4) — 조회는 본인, 같은 교회 관리자,
      // 플랫폼 관리자만. 비밀번호 변경은 Auth와 보상 transaction을 묶는 서버 함수만
      // 수행하며, 브라우저 관리자는 절대 직접 수정·삭제하지 않는다.
      // [라운드 10] 개인 계정 전환 교인은 churchId가 null이 되므로, 기준 공동체(primaryOrgId)
      // 관리자에게도 열어 어르신 비밀번호 지원이 전환 후에도 유지되게 한다.
      match /private/{privateId} {
        function credentialDocumentIsSafe(data) {
          return data.keys().hasOnly(['password', 'phone4', 'updatedAt']) &&
            data.keys().hasAll(['updatedAt']) &&
            data.updatedAt == request.time &&
            (!data.keys().hasAny(['password']) ||
              (data.password is string &&
                data.password.size() >= 6 && data.password.size() <= 128)) &&
            (!data.keys().hasAny(['phone4']) ||
              (data.phone4 is string && data.phone4.matches('^[0-9]{4}$')));
        }
        function createMatchesLegacyUser(data) {
          let userPath = /databases/$(database)/documents/users/$(uid);
          let user = get(userPath).data;
          return exists(userPath) &&
            (!data.keys().hasAny(['password']) ||
              (user.get('password', null) is string &&
                data.password == user.password)) &&
            (!data.keys().hasAny(['phone4']) ||
              (user.get('phone4', null) is string &&
                data.phone4 == user.phone4));
        }
        function updateMatchesLegacyUser(data, changed, allowNewPhone4) {
          let userPath = /databases/$(database)/documents/users/$(uid);
          let user = get(userPath).data;
          return exists(userPath) &&
            (!changed.hasAny(['password']) ||
              (user.get('password', null) is string &&
                data.password == user.password)) &&
            (!changed.hasAny(['phone4']) || allowNewPhone4 ||
              (user.get('phone4', null) is string &&
                data.phone4 == user.phone4));
        }
        function credentialOwnerIsActive() {
          let userPath = /databases/$(database)/documents/users/$(uid);
          return exists(userPath) &&
            get(userPath).data.get('isDeleted', false) != true;
        }
        function credentialTargetIsActiveMember() {
          let userPath = /databases/$(database)/documents/users/$(uid);
          return credentialOwnerIsActive() &&
            get(userPath).data.get('role', null) == 'member';
        }
        function credentialOwnerIsActiveOrSignupPending() {
          let userPath = /databases/$(database)/documents/users/$(uid);
          return !exists(userPath) ||
            get(userPath).data.get('isDeleted', false) != true;
        }
        allow read: if privateId == 'auth' && isRealUser() && (
          (request.auth.uid == uid && credentialOwnerIsActive()) ||
          isPlatformAdmin() ||
          (credentialTargetIsActiveMember() &&
            (isChurchAdmin(get(/databases/$(database)/documents/users/$(uid)).data.churchId) ||
              isChurchAdmin(get(/databases/$(database)/documents/users/$(uid)).data.get('primaryOrgId', null)))));
        // 신규 가입은 users 문서를 서버가 만들기 전에 본인이 auth 문서를 먼저 만든다.
        // 기존 사용자 이관은 users의 레거시 값과 정확히 같은 값만 복사할 수 있다.
        allow create: if privateId == 'auth' && credentialDocumentIsSafe(request.resource.data) &&
          ((isRealUser() && request.auth.uid == uid &&
              credentialOwnerIsActiveOrSignupPending() &&
              (!exists(/databases/$(database)/documents/users/$(uid)) ||
                createMatchesLegacyUser(request.resource.data))) ||
            (isPlatformAdmin() && createMatchesLegacyUser(request.resource.data)));
        // 본인은 가입 중 users 원장이 아직 없을 때 자격증명 재시도를 할 수 있다.
        // users 원장이 있으면 활성 계정의 개인 전환용 phone4 또는 남은 레거시 값만 갱신한다.
        // 플랫폼 관리자는 레거시 이관만 가능하고, 교회 관리자는 서버 함수만 사용한다.
        allow update: if privateId == 'auth' &&
          credentialDocumentIsSafe(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['password', 'phone4', 'updatedAt']) &&
          ((isRealUser() && request.auth.uid == uid &&
              credentialOwnerIsActiveOrSignupPending() &&
              (!exists(/databases/$(database)/documents/users/$(uid)) ||
                updateMatchesLegacyUser(
                  request.resource.data,
                  request.resource.data.diff(resource.data).affectedKeys(),
                  true
                ))) ||
            (isPlatformAdmin() &&
              updateMatchesLegacyUser(
                request.resource.data,
                request.resource.data.diff(resource.data).affectedKeys(),
                false
              )));
        allow delete: if false;
      }

      // 읽기·퀴즈 서버 action의 멱등 ledger. 소유자와 관리자도 브라우저 SDK로
      // 읽거나 만들 수 없고, 서비스 계정 transaction만 접근한다.
      match /activityActions/{requestId} {
        allow read, write: if false;
      }

      // progressKey+시도 슬롯 의미 기반 ledger. 여러 탭이 서로 다른 UUID로 같은
      // 답을 제출해도 한 번의 시도만 소비하며 서비스 계정만 접근한다.
      match /quizAttemptSlots/{slotId} {
        allow read, write: if false;
      }

      // 묵상은 사용자 본문서의 1 MiB 한도에 닿지 않도록 월·주 단위 문서로 분리한다.
      // 내용은 본인만 읽고 쓸 수 있으며 장기간 서버에 계속 보관한다.
      match /memoBuckets/{bucketId} {
        allow read, create, update, delete: if isRealUser() && request.auth.uid == uid;
      }

      // 읽기 기록 서브컬렉션 — 기록 생성은 completeRead 서버 action만 수행한다.
      // (같은 교회 churchAdmin read는 관리자 대시보드 "어제 이 시각 대비" 지표용 —
      //  기록엔 date/day/score/ts만 있어 자격증명 노출 없음.)
      match /history/{historyId} {
        allow read: if request.auth.uid == uid ||
          isChurchAdmin(get(/databases/$(database)/documents/users/$(uid)).data.churchId) ||
          isPlatformAdmin();
        allow create: if false;
        allow delete: if isPlatformAdmin() && uid.matches('^seed_.*');
      }
    }

    // 교회 문서 (Phase 3: 가입 전 조회는 settings/churchDirectory 공개 문서로 대체 → 인증 필수로 축소)
    match /churches/{churchId} {
      allow read: if isRealUser();
      // 신규 공동체와 보호 필드 변경은 platform-api의 검증된 transaction만 수행한다.
      // 브라우저에는 운영 중인 조직표(departments) 편집만 남긴다.
      allow create: if false;
      allow update: if (isChurchAdmin(churchId) || isPlatformAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['departments', 'updatedAt']);
      allow delete: if false;

      // 관리자 식별 정보는 교회 공개 본문서와 분리한다.
      match /private/{privateId} {
        allow read: if isChurchAdmin(churchId) || isPlatformAdmin();
        allow write: if false;
      }

      match /settings/{settingId} {
        // [라운드 10] roster 멤버도 읽기 허용 — 개인 계정이 소속 공동체의
        // 공지·카카오 링크·달란트 상점 설정을 읽을 수 있어야 한다 (라운드 9 공백 보완).
        allow read: if sameChurch(churchId) || isRosterMember(churchId) || isPlatformAdmin();
        allow write: if isChurchAdmin(churchId) || isPlatformAdmin();
      }

      // [라운드 8] 조직 명부(roster) — 조직 간 소속의 유일한 표현.
      // 계정(users)은 건드리지 않고, 각 조직이 자기 명부 행만 본다.
      // read: 그 조직의 자체 교인 / 그 조직 명부에 오른 사람(exists) / 그 조직 관리자.
      // create는 서버 가입·참여 action만, update는 공동체 관리자 배정만 수행한다.
      // delete는 잔액이 없는 본인 탈퇴 또는 관리자 제명에 한해 브라우저에서 허용한다.
      match /roster/{memberUid} {
        allow read: if isRealUser() && (
          myData().churchId == churchId ||
          isChurchAdmin(churchId) || isPlatformAdmin() ||
          exists(/databases/$(database)/documents/churches/$(churchId)/roster/$(request.auth.uid)));
        allow create: if false;
        allow update: if (isChurchAdmin(churchId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'departmentId', 'departmentName', 'subgroupId', 'subgroupName',
              'extraMemberships', 'updatedAt'
            ]) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['extraMemberships']) ||
              (request.resource.data.extraMemberships is list &&
                request.resource.data.extraMemberships.size() <= 3))) ||
          // 플랫폼 관리자 운영 도구는 별도 서버 이관 전까지 기존 권한을 유지한다.
          isPlatformAdmin();
        allow delete: if !isPersonalPrimaryRoster(churchId, memberUid) &&
          // roster.talent는 조직별 서버 원장이다. 양수 잔액을 문서 삭제로 소실시키지
          // 않으며, 환불·이관·명시적 포기는 후속 서버 탈퇴 action에서 처리한다.
          resource.data.get('talent', 0) == 0 &&
          (request.auth.uid == memberUid ||
            isChurchAdmin(churchId) || isPlatformAdmin());
      }

      // 달란트 상점 구매 내역 — 일반 구매는 서버 purchaseItem만 생성한다.
      // 클라이언트가 상품명·가격을 위조할 수 있으므로 교인의 직접 create는 허용하지 않는다.
      // 조회는 본인 것 + 교회 관리자 전체, 수령 처리(update)는 관리자만.
      match /talentPurchases/{purchaseId} {
        allow read: if isChurchAdmin(churchId) || isPlatformAdmin() ||
          (isSignedIn() && resource.data.uid == request.auth.uid);
        // 판매·수령·환불은 권한·가격·지갑·멱등 ledger를 함께 검증하는 서버 action만 쓴다.
        allow create, update, delete: if false;
      }

      // 관리자 판매·수령·환불의 멱등 감사 ledger. 서비스 계정만 쓰고
      // 브라우저 SDK에는 관리자 역할과 무관하게 읽기·쓰기를 모두 닫는다.
      match /talentAdminActions/{requestId} {
        allow read, write: if false;
      }
    }

    // 말씀 (verses) — 읽기 전용
    match /verses/{verseId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    // 차세대 공개 교회 디렉토리. 공개 화면에는 교회 ID, 이름, 숨김 여부만
    // 노출하며 브라우저 역할과 무관하게 모든 쓰기를 서비스 계정으로 제한한다.
    match /publicChurches/{churchId} {
      allow read: if isPublicDirectoryReady();
      allow write: if false;
    }

    // publicChurches 백필·전환 상태. mode가 public으로 확정되기 전 새 앱은
    // 기존 settings/churchDirectory를 계속 사용한다.
    match /publicDirectoryMeta/current {
      allow read: if resource.data.keys().hasOnly(
          ['ready', 'mode', 'schemaVersion', 'count', 'updatedAt'])
        && resource.data.keys().hasAll(['ready', 'mode', 'schemaVersion'])
        && resource.data.ready is bool
        && resource.data.mode in ['legacy', 'public']
        && resource.data.schemaVersion == 1
        && (!('count' in resource.data) ||
          (resource.data.count is int && resource.data.count >= 0))
        && (!('updatedAt' in resource.data) || resource.data.updatedAt is timestamp);
      allow write: if false;
    }

    // 공개 디렉토리 재생성 lease·소유권 fence. 서비스 계정 전용 내부 상태다.
    match /platformInternal/{documentId} {
      allow read, write: if false;
    }

    // 호환용 공개 교회 디렉토리 — 로그인 화면(미인증)의 교회 검색에 사용한다.
    // 신규 앱은 입장코드를 서버에서 검증하며 이 문서는 {id, name, hidden}만 유지한다.
    // Firestore는 겹치는 match를 우선순위가 아니라 OR로 합산한다. 따라서 아래의
    // 포괄적 settings 규칙에서도 이 문서를 명시적으로 제외해야 서버 전용 쓰기가 유지된다.
    match /settings/churchDirectory {
      allow read: if true;
      allow write: if false;
    }

    // 플랫폼 집계 통계 — 미인증 공개 읽기, 쓰기는 서버 action 전용.
    match /settings/platformStats {
      allow read: if true;
      allow write: if false;
    }

    // 매일 영상 자동화 설정 (YouTube API 키·재생목록 ID). 아래의 포괄적
    // settings/{settingId} 규칙과 겹치지만 명시적으로 둔다.
    match /settings/videoAutoConfig {
      allow read: if isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    // 그 외 설정 문서
    match /settings/{settingId} {
      allow read: if settingId != 'videoAutoConfig' && isSignedIn();
      allow write: if !(settingId in ['churchDirectory', 'platformStats']) &&
        isPlatformAdmin();
    }

    // [라운드 8] 내 명부 행 전체 조회 (collectionGroup) — 로그인 시 내 소속 조직 파악용.
    // uid 등호 필터가 필수라 남의 행은 목록 쿼리로 절대 나오지 않는다.
    match /{path=**}/roster/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // 매일 유튜브 영상 (플랫폼 관리자가 전체 교회 공용으로 등록).
    // 일반 사용자는 서버 resolve action만 호출한다. 수동 등록·삭제만 플랫폼 관리자에게 남긴다.
    match /dailyVideos/{dateId} {
      allow read: if isSignedIn();
      allow create: if isPlatformAdmin()
        && request.resource.data.keys().hasOnly(['adult', 'kids', 'updatedAt', 'autoFilled'])
        && validVideoEntry(request.resource.data.get('adult', null))
        && validVideoEntry(request.resource.data.get('kids', null));
      allow update, delete: if isPlatformAdmin();
    }
  }
}
