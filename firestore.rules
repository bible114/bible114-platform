rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isRealUser() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isPlatformAdmin() {
      return isSignedIn() &&
        myData().role in ['platformAdmin', 'superAdmin'];
    }
    function isChurchAdmin(churchId) {
      return isSignedIn() &&
        myData().role == 'churchAdmin' &&
        myData().churchId == churchId &&
        myData().get('isDeleted', false) != true;
    }
    function sameChurch(churchId) {
      return isSignedIn() && myData().churchId == churchId;
    }
    // [라운드 10] 조직 명부 멤버 — 개인 계정(churchId null)·타 교회 소속이라도
    // 그 조직 roster에 올라 있으면 공동체 콘텐츠(공지·상점 설정·구매)를 쓸 수 있다.
    function isRosterMember(churchId) {
      return isRealUser() &&
        exists(/databases/$(database)/documents/churches/$(churchId)/roster/$(request.auth.uid));
    }
    // personal 사용자의 primary roster는 곧 지갑 원장이다. 본인·공동체 관리자·
    // 플랫폼 관리자 브라우저도 삭제할 수 없고, 기준 변경/제명은 서버 action만 맡는다.
    function isPersonalPrimaryRoster(churchId, memberUid) {
      let before = get(/databases/$(database)/documents/users/$(memberUid)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(memberUid)).data;
      return exists(/databases/$(database)/documents/users/$(memberUid)) &&
        ((before.get('accountType', null) == 'personal' &&
            before.get('primaryOrgId', null) == churchId) ||
          (after.get('accountType', null) == 'personal' &&
            after.get('primaryOrgId', null) == churchId));
    }
    // 본인 users 쓰기에서 score/talent와 legacy 이관 표식을 함께 검증한다.
    // - 이미 이관된 true 표식은 절대 되돌릴 수 없다.
    // - personal 계정은 보상·구매·지갑 이관을 서버·roster로만 처리하므로
    //   true→true 브라우저 쓰기에서 users.score/talent를 완전히 동결한다.
    // - 일반 공동체 계정의 true→true는 구버전 호환 보상 상한을 유지한다.
    // - 아직 이관 전이면 일반 설정 쓰기는 허용하되 score/talent는 동결한다.
    // - 최초 false→true 이관의 spendable talent는 반드시 이관 전 score와 같아야 한다.
    //   과거 구매 복원분은 score에만 더해지므로 브라우저가 새 달란트를 mint할 수 없다.
    function isSafeSelfScoreTalentUpdate(before, after) {
      let wasMigrated = before.get('talentMigrated', false) == true;
      let isMigrated = after.get('talentMigrated', false) == true;
      let beforeScore = before.get('score', 0);
      let beforeTalent = before.get('talent', 0);
      let afterScore = after.get('score', 0);
      let afterTalent = after.get('talent', 0);
      return beforeScore is int && beforeTalent is int &&
        afterScore is int && afterTalent is int &&
        beforeScore >= 0 && beforeScore <= 1000000000 &&
        beforeTalent >= 0 && beforeTalent <= 1000000000 &&
        afterScore >= 0 && afterScore <= 1000000000 &&
        afterTalent >= 0 && afterTalent <= 1000000000 &&
        ((!wasMigrated && !isMigrated &&
            afterScore == beforeScore && afterTalent == beforeTalent) ||
          (!wasMigrated && isMigrated &&
            afterTalent == beforeScore && afterScore >= beforeScore) ||
          (wasMigrated && isMigrated &&
            ((before.get('accountType', null) == 'personal' &&
                afterTalent == beforeTalent &&
                afterScore == beforeScore) ||
              (before.get('accountType', null) != 'personal' &&
                afterTalent <= beforeTalent + 17 &&
                afterScore <= beforeScore + 15))));
    }
    // dailyVideos의 adult/kids 항목 검증: 없거나(null), url 필드가 없거나, url이 빈 문자열이면
    // 통과(자동 채움 실패 시 그런 형태로 기록됨). url이 있으면 반드시 유튜브 도메인이어야 한다.
    // RE2 정규식이라 리터럴 마침표는 [.]로 이스케이프한다.
    function validVideoEntry(e) {
      return e == null || !('url' in e) || e.url == '' ||
        e.url.matches('^https://(www[.])?(youtube[.]com|youtu[.]be)/.*');
    }
    function isPublicDirectoryReady() {
      let meta = get(/databases/$(database)/documents/publicDirectoryMeta/current).data;
      return meta.keys().hasOnly(
          ['ready', 'mode', 'schemaVersion', 'count', 'updatedAt']) &&
        meta.keys().hasAll(['ready', 'mode', 'schemaVersion', 'count']) &&
        meta.ready == true &&
        meta.mode == 'public' &&
        meta.schemaVersion == 1 &&
        meta.count is int &&
        meta.count >= 0;
    }

    // 사용자 문서
    match /users/{uid} {
      // [랭킹] 마지막 분기: 같은 교회 교인의 목록 조회 허용(랭킹·달리기·주간MVP).
      // 단 자격증명(password/phone4)이 private 하위문서로 이관 완료된 문서
      // (password == null 마커)만 — 이관 전 평문 노출 창을 규칙 수준에서 차단한다.
      // 클라이언트 목록 쿼리는 반드시 .where('password', '==', null)을 포함해야
      // 규칙 증명을 통과한다 (useDepartment.loadAllMembers 참고).
      // 무소속 가상 교회(unaffiliated_v1)는 전국 단위 익명 집단이라 서로 열지 않는다.
      allow read: if request.auth.uid == uid ||
        (isSignedIn() && isChurchAdmin(resource.data.churchId)) ||
        isPlatformAdmin() ||
        (sameChurch(resource.data.churchId) &&
          resource.data.churchId != 'unaffiliated_v1' &&
          resource.data.password == null) ||
        // [라운드 9] 명부(roster) 멤버의 조직 자체 교인 읽기 — 개인 계정(churchId null)이나
        // 타 교회 소속이라도, 그 조직 명부에 올라 있으면 그 조직 교인 목록(랭킹)을 볼 수 있다.
        // 목록 쿼리: .where('churchId','==',org).where('password','==',null) — churchId가 필터로
        // 증명되므로 exists 경로가 구체화되어 규칙 증명을 통과한다.
        (isRealUser() &&
          resource.data.churchId != 'unaffiliated_v1' &&
          resource.data.password == null &&
          exists(/databases/$(database)/documents/churches/$(resource.data.churchId)/roster/$(request.auth.uid)));
      // 교회 교인 최초 문서는 completeMemberSignup 서버만 생성한다.
      // 클라이언트 직접 생성은 기존 무소속 교인 호환 경로만 남긴다.
      // 개인계정은 completePersonalSignup 서버만 생성한다.
      // 공동체 관리자는 completeChurchAdminSignup 서버만 생성한다.
      allow create: if isRealUser() && request.auth.uid == uid &&
        request.resource.data.role == 'member' &&
          request.resource.data.churchId == 'unaffiliated_v1' &&
          request.resource.data.get('accountType', null) != 'personal' &&
          request.resource.data.get('primaryOrgId', null) == null &&
          request.resource.data.get('score', 0) == 0 &&
          request.resource.data.get('talent', 0) == 0 &&
          request.resource.data.get('talentMigrated', false) == true &&
          request.resource.data.get('talentWalletMigrated', false) == false &&
          request.resource.data.get('isDeleted', false) == false &&
          request.resource.data.extraMemberships is list &&
          request.resource.data.extraMemberships.size() == 0 &&
          request.resource.data.currentDay is int &&
          request.resource.data.currentDay >= 1 &&
          request.resource.data.currentDay <= 365 &&
          request.resource.data.readCount == 1 &&
          request.resource.data.get('departmentId', null) == null &&
          request.resource.data.get('departmentName', null) == null &&
          request.resource.data.get('subgroupId', null) == null &&
          request.resource.data.get('subgroupName', null) == null;
      // 본인 수정은 정체성·삭제 상태를 바꿀 수 없다 (권한 상승·탈퇴 복구 차단).
      // affectedKeys()는 값이 실제로 바뀐 필드만 보고하므로, 기존 값과 동일한 role/churchId를
      // 포함해 문서 전체를 다시 쓰는 정상 흐름(App.jsx의 setCurrentUser 반영 저장 등)은 영향 없다.
      allow update: if (request.auth.uid == uid &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'churchId', 'accountType', 'isDeleted', 'extraMemberships',
              'deletedAt', 'deletedBy', 'onboardingPending',
              'talentWalletMigrated', 'departmentId', 'departmentName',
              'subgroupId', 'subgroupName']) &&
          resource.data.get('isDeleted', false) != true &&
          request.resource.data.get('isDeleted', false) != true &&
          // 부서·소그룹은 서버 가입 또는 공동체 관리자만 배정한다.
          // 기준 공동체는 실제 내 roster가 있는 조직 또는 null로만 바꿀 수 있다.
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['primaryOrgId']) ||
            request.resource.data.get('primaryOrgId', null) == null ||
            existsAfter(/databases/$(database)/documents/churches/$(request.resource.data.primaryOrgId)/roster/$(request.auth.uid))) &&
          // personal users 지갑 감소와 완료 표식은 서버 action만 처리한다.
          (resource.data.get('accountType', null) != 'personal' ||
            request.resource.data.get('talent', 0) >= resource.data.get('talent', 0)) &&
          isSafeSelfScoreTalentUpdate(resource.data, request.resource.data)) ||
        // 공동체 관리자는 같은 교회의 일반 교인 삭제/복원·소속 배정만 할 수 있다.
        // role/churchId/accountType/보상·진도 등 전체 users 수정 권한은 주지 않는다.
        (isSignedIn() &&
          resource.data.role == 'member' &&
          request.resource.data.role == 'member' &&
          isChurchAdmin(resource.data.churchId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isDeleted', 'deletedAt', 'deletedBy',
            'departmentId', 'departmentName', 'subgroupId', 'subgroupName',
            'extraMemberships', 'updatedAt'
          ]) &&
          // 삭제 감사 필드는 삭제 상태 전이와 함께만 바뀌며 행위자·시각을 위조하지 못한다.
          ((!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['isDeleted', 'deletedAt', 'deletedBy'])) ||
            (resource.data.get('isDeleted', false) != true &&
              request.resource.data.isDeleted == true &&
              request.resource.data.deletedAt == request.time &&
              request.resource.data.deletedBy == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasAll(['isDeleted', 'deletedAt', 'deletedBy'])) ||
            (resource.data.get('isDeleted', false) == true &&
              request.resource.data.isDeleted == false &&
              request.resource.data.deletedAt == null &&
              request.resource.data.deletedBy == null &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasAll(['isDeleted', 'deletedAt', 'deletedBy']))) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['extraMemberships']) ||
            (request.resource.data.extraMemberships is list &&
              request.resource.data.extraMemberships.size() <= 3))) ||
        isPlatformAdmin();
      // 개인 지갑 이관과 창구 판매·환불은 platform-api가 transaction으로 처리한다.
      // 브라우저에는 users.talent 감소·talentWalletMigrated 변경 권한을 열지 않는다.
      // [라운드 10] 개인 계정 전환(일방향, 본인만): 교회 교인 → accountType 'personal' + churchId null.
      // 전환 전에 자기 roster 행(구 교회)이 먼저 만들어져 있어야 한다 — 소속이 명부 원장으로
      // 보존됨을 규칙 수준에서 강제. 다른 교회로의 churchId 변경이나 personal → 교회 복귀는
      // 이 분기로 열리지 않는다 (역방향은 라운드 후보).
      allow update: if request.auth.uid == uid &&
        resource.data.role == 'member' &&
        request.resource.data.role == 'member' &&
        resource.data.get('isDeleted', false) != true &&
        request.resource.data.get('isDeleted', false) != true &&
        resource.data.get('accountType', null) != 'personal' &&
        resource.data.churchId is string &&
        resource.data.churchId != 'unaffiliated_v1' &&
        request.resource.data.churchId == null &&
        request.resource.data.accountType == 'personal' &&
        request.resource.data.get('primaryOrgId', null) == resource.data.churchId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['accountType', 'email', 'churchId', 'churchName', 'primaryOrgId', 'updatedAt']) &&
        exists(/databases/$(database)/documents/churches/$(resource.data.churchId)/roster/$(request.auth.uid));
      // 무료 플랜에서는 실제 삭제 대신 isDeleted로 숨긴다.
      // seed_ 테스트 문서만 플랫폼 관리자가 클라이언트에서 직접 지울 수 있다.
      allow delete: if isPlatformAdmin() && uid.matches('^seed_.*');

      // 가입 동의 원문 — 보호자 성명·관계 등 감사용 개인정보가 포함될 수 있으므로
      // 공동체 관리자에게는 읽기·쓰기를 열지 않는다. 본인은 재가입 시 최신 동의로
      // 갱신할 수 있고, 플랫폼 관리자는 분쟁 대응을 위한 읽기만 가능하다.
      match /private/consent {
        allow read: if isRealUser() && (request.auth.uid == uid || isPlatformAdmin());
        allow create, update: if isRealUser() && request.auth.uid == uid;
        allow delete: if false;
      }

      // 자격증명 하위문서 (평문 비밀번호·phone4) — 본인, 같은 교회 관리자, 플랫폼 관리자만.
      // users 본문서 read가 같은 교회 교인에게 열려도 이 문서는 절대 열리지 않는다.
      // [라운드 10] 개인 계정 전환 교인은 churchId가 null이 되므로, 기준 공동체(primaryOrgId)
      // 관리자에게도 열어 어르신 비밀번호 지원이 전환 후에도 유지되게 한다.
      match /private/{privateId} {
        allow read, write: if privateId != 'consent' && isRealUser() && (
          request.auth.uid == uid ||
          isChurchAdmin(get(/databases/$(database)/documents/users/$(uid)).data.churchId) ||
          isChurchAdmin(get(/databases/$(database)/documents/users/$(uid)).data.get('primaryOrgId', null)) ||
          isPlatformAdmin());
      }

      // 읽기·퀴즈 서버 action의 멱등 ledger. 소유자와 관리자도 브라우저 SDK로
      // 읽거나 만들 수 없고, 서비스 계정 transaction만 접근한다.
      match /activityActions/{requestId} {
        allow read, write: if false;
      }

      // progressKey+시도 슬롯 의미 기반 ledger. 여러 탭이 서로 다른 UUID로 같은
      // 답을 제출해도 한 번의 시도만 소비하며 서비스 계정만 접근한다.
      match /quizAttemptSlots/{slotId} {
        allow read, write: if false;
      }

      // 읽기 기록 서브컬렉션 — 본인 읽기/쓰기, 같은 교회 관리자·플랫폼 관리자 읽기.
      // (같은 교회 churchAdmin read는 관리자 대시보드 "어제 이 시각 대비" 지표용 —
      //  기록엔 date/day/score/ts만 있어 자격증명 노출 없음.)
      match /history/{historyId} {
        allow read: if request.auth.uid == uid ||
          isChurchAdmin(get(/databases/$(database)/documents/users/$(uid)).data.churchId) ||
          isPlatformAdmin();
        allow create: if request.auth.uid == uid;
        allow delete: if isPlatformAdmin() && uid.matches('^seed_.*');
      }
    }

    // 교회 문서 (Phase 3: 가입 전 조회는 settings/churchDirectory 공개 문서로 대체 → 인증 필수로 축소)
    match /churches/{churchId} {
      allow read: if isRealUser();
      // 신규 공동체와 보호 필드 변경은 platform-api의 검증된 transaction만 수행한다.
      // 브라우저에는 운영 중인 조직표(departments) 편집만 남긴다.
      allow create: if false;
      allow update: if (isChurchAdmin(churchId) || isPlatformAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['departments', 'updatedAt']);
      allow delete: if false;

      // 관리자 식별 정보는 교회 공개 본문서와 분리한다.
      match /private/{privateId} {
        allow read: if isChurchAdmin(churchId) || isPlatformAdmin();
        allow write: if false;
      }

      match /settings/{settingId} {
        // [라운드 10] roster 멤버도 읽기 허용 — 개인 계정이 소속 공동체의
        // 공지·카카오 링크·달란트 상점 설정을 읽을 수 있어야 한다 (라운드 9 공백 보완).
        allow read: if sameChurch(churchId) || isRosterMember(churchId) || isPlatformAdmin();
        allow write: if isChurchAdmin(churchId) || isPlatformAdmin();
      }

      // [라운드 8] 조직 명부(roster) — 조직 간 소속의 유일한 표현.
      // 계정(users)은 건드리지 않고, 각 조직이 자기 명부 행만 본다.
      // read: 그 조직의 자체 교인 / 그 조직 명부에 오른 사람(exists) / 그 조직 관리자.
      // create: 일반 추가 공동체 가입은 서버 joinCommunity만 처리한다. 클라이언트 직접 생성은
      // 무소속과 자기 원래 교회의 개인계정 전환만 남긴다.
      // 신규 개인/소셜 가입은 completePersonalSignup 서버만 처리한다.
      // update: 본인(uid 변조 금지) 또는 그 조직 관리자(소그룹 배정). delete: 본인(탈퇴)·관리자(제명).
      match /roster/{memberUid} {
        allow read: if isRealUser() && (
          myData().churchId == churchId ||
          isChurchAdmin(churchId) || isPlatformAdmin() ||
          exists(/databases/$(database)/documents/churches/$(churchId)/roster/$(request.auth.uid)));
        allow create: if isRealUser() && request.auth.uid == memberUid &&
          request.resource.data.uid == memberUid &&
          request.resource.data.keys().hasOnly(
            ['uid', 'name', 'score', 'currentDay', 'streak', 'readCount', 'lastReadDate', 'talent',
             'departmentId', 'departmentName', 'subgroupId', 'subgroupName', 'extraMemberships',
             'joinedAt', 'updatedAt']) &&
          request.resource.data.talent == 0 &&
          request.resource.data.extraMemberships is list &&
          request.resource.data.extraMemberships.size() == 0 &&
          (
            (churchId == 'unaffiliated_v1' &&
              exists(/databases/$(database)/documents/users/$(memberUid)) &&
              get(/databases/$(database)/documents/users/$(memberUid)).data.churchId == churchId &&
              get(/databases/$(database)/documents/users/$(memberUid)).data.get('isDeleted', false) != true &&
              request.resource.data.name == get(/databases/$(database)/documents/users/$(memberUid)).data.get('name', '') &&
              request.resource.data.score == get(/databases/$(database)/documents/users/$(memberUid)).data.get('score', 0) &&
              request.resource.data.currentDay == get(/databases/$(database)/documents/users/$(memberUid)).data.get('currentDay', 1) &&
              request.resource.data.streak == get(/databases/$(database)/documents/users/$(memberUid)).data.get('streak', 0) &&
              request.resource.data.readCount == get(/databases/$(database)/documents/users/$(memberUid)).data.get('readCount', 1) &&
              request.resource.data.lastReadDate == get(/databases/$(database)/documents/users/$(memberUid)).data.get('lastReadDate', null) &&
              request.resource.data.get('departmentId', null) == get(/databases/$(database)/documents/users/$(memberUid)).data.get('departmentId', null) &&
              request.resource.data.get('departmentName', null) == get(/databases/$(database)/documents/users/$(memberUid)).data.get('departmentName', null) &&
              request.resource.data.get('subgroupId', null) == get(/databases/$(database)/documents/users/$(memberUid)).data.get('subgroupId', null) &&
              request.resource.data.get('subgroupName', null) == get(/databases/$(database)/documents/users/$(memberUid)).data.get('subgroupName', null)) ||
            // 교회 회원 → 개인 계정 전환은 기존 교회 명부를 먼저 만든 뒤 users를 전환한다.
            (exists(/databases/$(database)/documents/users/$(memberUid)) &&
              get(/databases/$(database)/documents/users/$(memberUid)).data.churchId == churchId &&
              get(/databases/$(database)/documents/users/$(memberUid)).data.get('isDeleted', false) != true &&
              request.resource.data.name == get(/databases/$(database)/documents/users/$(memberUid)).data.get('name', '') &&
              request.resource.data.score == get(/databases/$(database)/documents/users/$(memberUid)).data.get('score', 0) &&
              request.resource.data.currentDay == get(/databases/$(database)/documents/users/$(memberUid)).data.get('currentDay', 1) &&
              request.resource.data.streak == get(/databases/$(database)/documents/users/$(memberUid)).data.get('streak', 0) &&
              request.resource.data.readCount == get(/databases/$(database)/documents/users/$(memberUid)).data.get('readCount', 1) &&
              request.resource.data.lastReadDate == get(/databases/$(database)/documents/users/$(memberUid)).data.get('lastReadDate', null) &&
              request.resource.data.get('departmentId', null) == get(/databases/$(database)/documents/users/$(memberUid)).data.get('departmentId', null) &&
              request.resource.data.get('departmentName', null) == get(/databases/$(database)/documents/users/$(memberUid)).data.get('departmentName', null) &&
              request.resource.data.get('subgroupId', null) == get(/databases/$(database)/documents/users/$(memberUid)).data.get('subgroupId', null) &&
              request.resource.data.get('subgroupName', null) == get(/databases/$(database)/documents/users/$(memberUid)).data.get('subgroupName', null))
          );
        // 본인 update: create와 같은 필드 화이트리스트 + joinedAt 불변.
        // (T46 경합 방어 — 기존 행 위에 set()이 오면 joinedAt(serverTimestamp)이 기존 값과
        //  달라져 거부된다 → 관리자 배정·가입 시각의 조용한 덮어쓰기가 안전한 실패로 바뀐다.)
        allow update: if (isRealUser() && request.auth.uid == memberUid &&
            request.resource.data.uid == memberUid &&
            request.resource.data.keys().hasOnly(
              ['uid', 'name', 'score', 'currentDay', 'streak', 'readCount', 'lastReadDate', 'talent',
               'departmentId', 'departmentName', 'subgroupId', 'subgroupName', 'extraMemberships',
               'joinedAt', 'updatedAt']) &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['departmentId', 'departmentName', 'subgroupId', 'subgroupName']) &&
            request.resource.data.joinedAt == resource.data.joinedAt &&
            // 회원의 읽기·퀴즈 동기화는 추가 소속을 그대로 보존해야 한다.
            // 필드가 없는 레거시 행은 빈 배열과 동일하게 취급한다.
            request.resource.data.get('extraMemberships', []) ==
              resource.data.get('extraMemberships', []) &&
            request.resource.data.get('score', 0) >= 0 &&
            request.resource.data.get('talent', 0) >= 0 &&
            // personal의 모든 공동체 지갑은 서버 읽기·퀴즈·구매 action만 갱신한다.
            // primary/secondary를 가리지 않고 브라우저 score/talent를 exact-freeze한다.
            // getAfter를 써서 일반→personal 전환과 같은 transaction의 +15/+17 mint도 막는다.
            ((getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data
                  .get('accountType', null) == 'personal' &&
                request.resource.data.get('score', 0) == resource.data.get('score', 0) &&
                request.resource.data.get('talent', 0) == resource.data.get('talent', 0)) ||
              (getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data
                  .get('accountType', null) != 'personal' &&
                // 일반 공동체 계정의 구버전 호환: roster.score는 users.score 미러다.
                // 증분 상한(+15) 또는 users 문서와의 절대값 동기화까지 허용한다.
                (request.resource.data.get('score', 0) <= resource.data.get('score', 0) + 15 ||
                  request.resource.data.get('score', 0) <=
                    getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('score', 0)) &&
                request.resource.data.get('talent', 0) <= resource.data.get('talent', 0) + 17))) ||
          (isChurchAdmin(churchId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'departmentId', 'departmentName', 'subgroupId', 'subgroupName',
              'extraMemberships', 'updatedAt'
            ]) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['extraMemberships']) ||
              (request.resource.data.extraMemberships is list &&
                request.resource.data.extraMemberships.size() <= 3))) ||
          // 플랫폼 관리자 운영 도구는 별도 서버 이관 전까지 기존 권한을 유지한다.
          isPlatformAdmin();
        allow delete: if !isPersonalPrimaryRoster(churchId, memberUid) &&
          // roster.talent는 조직별 서버 원장이다. 양수 잔액을 문서 삭제로 소실시키지
          // 않으며, 환불·이관·명시적 포기는 후속 서버 탈퇴 action에서 처리한다.
          resource.data.get('talent', 0) == 0 &&
          (request.auth.uid == memberUid ||
            isChurchAdmin(churchId) || isPlatformAdmin());
      }

      // 달란트 상점 구매 내역 — 일반 구매는 서버 purchaseItem만 생성한다.
      // 클라이언트가 상품명·가격을 위조할 수 있으므로 교인의 직접 create는 허용하지 않는다.
      // 조회는 본인 것 + 교회 관리자 전체, 수령 처리(update)는 관리자만.
      match /talentPurchases/{purchaseId} {
        allow read: if isChurchAdmin(churchId) || isPlatformAdmin() ||
          (isSignedIn() && resource.data.uid == request.auth.uid);
        // 창구 판매(관리자 대리 차감): 앱 사용이 어려운 어르신 교인을 대신해 관리자가
        // 달란트를 차감하며 구입 물품을 기록한다. 즉시 수령이므로 delivered로 생성.
        allow create: if (isChurchAdmin(churchId) || isPlatformAdmin()) &&
          request.resource.data.status == 'delivered' &&
          request.resource.data.keys().hasOnly(
            ['uid', 'memberName', 'itemId', 'itemName', 'price', 'status',
             'createdAt', 'deliveredAt', 'deliveredBy', 'schemaVersion', 'departmentId',
             'departmentName', 'marketId', 'walletKind', 'walletOrgId']) &&
          (!('schemaVersion' in request.resource.data) ||
            (request.resource.data.schemaVersion == 2 &&
              request.resource.data.departmentId is string &&
              request.resource.data.marketId is string &&
              request.resource.data.walletKind in ['user', 'roster'] &&
              request.resource.data.walletOrgId == churchId));
        allow update: if (isChurchAdmin(churchId) || isPlatformAdmin()) &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['delivered', 'cancelled'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status', 'deliveredAt', 'deliveredBy']);
        allow delete: if isPlatformAdmin();
      }

      // 관리자 판매·수령·환불의 멱등 감사 ledger. 서비스 계정만 쓰고
      // 브라우저 SDK에는 관리자 역할과 무관하게 읽기·쓰기를 모두 닫는다.
      match /talentAdminActions/{requestId} {
        allow read, write: if false;
      }
    }

    // 말씀 (verses) — 읽기 전용
    match /verses/{verseId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    // 차세대 공개 교회 디렉토리. 공개 화면에는 교회 ID, 이름, 숨김 여부만
    // 노출하며 브라우저 역할과 무관하게 모든 쓰기를 서비스 계정으로 제한한다.
    match /publicChurches/{churchId} {
      allow read: if isPublicDirectoryReady();
      allow write: if false;
    }

    // publicChurches 백필·전환 상태. mode가 public으로 확정되기 전 새 앱은
    // 기존 settings/churchDirectory를 계속 사용한다.
    match /publicDirectoryMeta/current {
      allow read: if resource.data.keys().hasOnly(
          ['ready', 'mode', 'schemaVersion', 'count', 'updatedAt'])
        && resource.data.keys().hasAll(['ready', 'mode', 'schemaVersion'])
        && resource.data.ready is bool
        && resource.data.mode in ['legacy', 'public']
        && resource.data.schemaVersion == 1
        && (!('count' in resource.data) ||
          (resource.data.count is int && resource.data.count >= 0))
        && (!('updatedAt' in resource.data) || resource.data.updatedAt is timestamp);
      allow write: if false;
    }

    // 공개 디렉토리 재생성 lease·소유권 fence. 서비스 계정 전용 내부 상태다.
    match /platformInternal/{documentId} {
      allow read, write: if false;
    }

    // 호환용 공개 교회 디렉토리 — 로그인 화면(미인증)의 교회 검색에 사용한다.
    // 신규 앱은 입장코드를 서버에서 검증하며 이 문서는 {id, name, hidden}만 유지한다.
    // Firestore는 겹치는 match를 우선순위가 아니라 OR로 합산한다. 따라서 아래의
    // 포괄적 settings 규칙에서도 이 문서를 명시적으로 제외해야 서버 전용 쓰기가 유지된다.
    match /settings/churchDirectory {
      allow read: if true;
      allow write: if false;
    }

    // 플랫폼 집계 통계 — 미인증 공개 읽기 (로그인 페이지에서 사용)
    // Phase 3-4: 완전 차단은 Cloud Functions 없이는 불가하므로 필드 화이트리스트 + 생성 제한으로 완화.
    // (필드 안의 "값" 자체 조작은 여전히 가능 — 알려진 한계. 근본 해결은 추후 Cloud Functions 과제.)
    match /settings/platformStats {
      allow read: if true;
      allow update: if isRealUser()
        && request.resource.data.keys().hasOnly(
          ['total_churches', 'total_readers', 'finished_total', 'readers_today',
           'chapters_read_today', 'today_date', 'updatedAt']);
      allow create: if isPlatformAdmin();
    }

    // 매일 영상 자동화 설정 (YouTube API 키·재생목록 ID). 아래의 포괄적
    // settings/{settingId} 규칙과 겹치지만 명시적으로 둔다.
    match /settings/videoAutoConfig {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    // 그 외 설정 문서
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if settingId != 'churchDirectory' && isPlatformAdmin();
    }

    // [라운드 8] 내 명부 행 전체 조회 (collectionGroup) — 로그인 시 내 소속 조직 파악용.
    // uid 등호 필터가 필수라 남의 행은 목록 쿼리로 절대 나오지 않는다.
    match /{path=**}/roster/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // 매일 유튜브 영상 (플랫폼 관리자가 전체 교회 공용으로 등록).
    // Phase 2b: 로그인 사용자가 최초 접속 시 YouTube API로 자동 채움(lazy fill)한 문서를
    // 스스로 생성할 수 있도록 create만 필드 화이트리스트로 허용한다. 이미 있는 문서를
    // 덮어쓰는 수정/삭제(수동 등록 오버라이드 포함)는 플랫폼 관리자만 가능.
    match /dailyVideos/{dateId} {
      allow read: if isSignedIn();
      // adult/kids가 존재하면 유튜브 URL 형식이어야 임의 콘텐츠(피싱 링크 등) 주입을 막는다.
      // 단, 플랫폼 관리자는 이 URL 형식 검증에서 제외한다 — 관리자가 아직 문서가 없는
      // "미래 날짜"에 처음으로 수동 등록(saveDailyVideo)하면 Firestore 관점에서는 update가
      // 아니라 create로 평가되는데, 관리자 입력 폼은 유튜브가 아닌 URL(예: 자체 호스팅 영상)도
      // 허용하므로 여기서 막으면 정상적인 관리자 흐름이 깨진다. 화이트리스트(필드 제한)는
      // 관리자에게도 그대로 적용된다.
      // TODO(security): 미래 날짜의 dateId를 미리 선점(스쿼팅)해 유효한 유튜브 URL로 채우는
      // 것 자체는 규칙만으로 막을 수 없다 (dateId 문자열과 "오늘 날짜"의 일치 여부를 rules에서
      // 검증할 방법이 없음). 완전한 차단은 Cloud Functions(서버 시간 기준 검증)가 필요.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['adult', 'kids', 'updatedAt', 'autoFilled'])
        && (isPlatformAdmin() ||
            (validVideoEntry(request.resource.data.get('adult', null)) &&
             validVideoEntry(request.resource.data.get('kids', null))));
      allow update, delete: if isPlatformAdmin();
    }
  }
}
